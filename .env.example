# Variables de Entorno del Cliente (Vite)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu_clave_publica_anon_o_publishable
VITE_SUPABASE_ANON_KEY=tu_clave_publica_anon_o_publishable

# Variables de Entorno del Servidor (Serverless / Vercel / Local)
# NUNCA agregues claves reales en este archivo ni uses prefijo VITE_ para claves secretas.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=tu_clave_secreta_cron_64_caracteres
GEMINI_API_KEY=tu_api_key_de_google_gemini

# ==============================================================================
# CALLMEBOT WHATSAPP API (100% Gratuito para alertas administrativas)
# ==============================================================================
# Pasos de activación:
# 1. Agrega el número de CallMeBot a tus contactos de WhatsApp: +34 644 10 55 84
# 2. Envía el mensaje exacto: "I allow callmebot to send me messages"
# 3. Recibirás tu API Key gratuita en un mensaje de respuesta.
# 4. Configura el número con código de país (ej. 50688888888 para Costa Rica).
WHATSAPP_ADMIN_PHONE=50688888888
CALLMEBOT_API_KEY=tu_callmebot_api_key
